{
  "name": "docutray",
  "version": "0.1.3",
  "description": "Node.js library for the DocuTray API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "attw": "attw --pack .",
    "pack-check": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docutray/docutray-node.git"
  },
  "keywords": [
    "docutray",
    "ocr",
    "document processing",
    "data extraction",
    "api",
    "sdk"
  ],
  "author": "Roberto Arce <robertoarcee@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/docutray/docutray-node/issues"
  },
  "homepage": "https://docutray.com",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@types/node": "^25.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.2.4",
    "eslint": "^9.39.2",
    "msw": "^2.12.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
