{
  "name": "docutray",
  "version": "0.1.0",
  "description": "Node.js library for the DocuTray API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docutray/docutray-node.git"
  },
  "keywords": [
    "docutray",
    "ocr",
    "document processing",
    "data extraction",
    "api",
    "sdk"
  ],
  "author": "Roberto Arce <robertoarcee@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/docutray/docutray-node/issues"
  },
  "homepage": "https://docutray.com",
  "engines": {
    "node": ">=18"
  }
}
